{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": ["chrome"],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "noEmit": false,
        "sourceMap": true,
        "baseUrl": ".",
        "paths": { "@src/*": ["../*"] }
    },
    "include": ["./**/*.ts", "../../packages/web/src/**/*.ts"]
}
