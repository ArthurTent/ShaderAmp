{
    "name": "shader-amp",
    "version": "2.0.3",
    "description": "Unofficial ShaderToy Chrome Extension to visualize sound of any page.",
    "main": "index.js",
    "scripts": {
        "build": "webpack --config webpack.prod.js",
        "build:chrome": "webpack --config webpack.prod.js && node src/buildManifest.js --browser chrome",
        "build:firefox": "webpack --config webpack.prod.js && node src/buildManifest.js --browser firefox",
        "build:zip:chrome": "npm run build && node src/packageExtension.js --browser chrome",
        "build:zip:firefox": "npm run build && node src/packageExtension.js --browser firefox",
        "dev": "webpack -w --config webpack.dev.js",
        "test": "jest --config=jest.config.js",
        "lint": "eslint --fix -c ./.eslintrc.js \"src/**/*.ts*\"",
        "prettify": "prettier --write \"src/**/*.ts*\"",
        "build_shader_list": "node ./src/buildShaderList.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aeksco/react-typescript-chrome-extension-starter.git"
    },
    "keywords": [
        "react",
        "typescript",
        "chrome",
        "extension",
        "boilerplate"
    ],
    "author": "Alexander Schwartzberg",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/aeksco/react-typescript-chrome-extension-starter/issues"
    },
    "homepage": "https://github.com/aeksco/react-typescript-chrome-extension-starter#readme",
